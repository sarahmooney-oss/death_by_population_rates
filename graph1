{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "COVID-19 peaked in 2021 but never came close to cancer or circulatory disease",
    "subtitle": [
      "Deaths per 100,000 people in Ireland by cause, 2020–2024. Use the drop-down to highlight a cause.",
      "Source: CSO VSA101 & Census 2022. Rates use 2022 population for every year; not age-adjusted."
    ]
  },
  "data": {
    "url": "https://raw.githubusercontent.com/sarahmooney-oss/death_by_population_rates/refs/heads/main/deaths_population_rates.csv",
    "format": {
      "type": "csv"
    }
  },
  "width": 560,
  "height": 340,
  "transform": [
    {
      "calculate": "datum['Cause of Death'] == 'C00-C99 Malignant neoplasms' ? 'Cancer' : datum['Cause of Death'] == 'I00-I99 Diseases of the circulatory system' ? 'Circulatory' : datum['Cause of Death'] == 'J00-J99 Diseases of the respiratory system' ? 'Respiratory' : datum['Cause of Death'] == 'V00-Y98 External causes of injury and poisoning' ? 'External causes' : datum['Cause of Death'] == 'F01 and F03 Dementia (types of)' ? 'Dementia' : datum['Cause of Death'] == 'G30 Alzheimer disease' ? 'Alzheimers' : 'COVID-19'",
      "as": "Cause"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Deaths",
          "as": "Deaths"
        },
        {
          "op": "sum",
          "field": "Population",
          "as": "Population"
        }
      ],
      "groupby": [
        "Year",
        "Cause"
      ]
    },
    {
      "calculate": "datum.Deaths / datum.Population * 100000",
      "as": "Rate"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "Rate",
      "type": "quantitative",
      "title": "Deaths per 100,000"
    },
    "color": {
      "field": "Cause",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "COVID-19",
          "Respiratory",
          "Cancer",
          "Circulatory",
          "Dementia",
          "Alzheimers",
          "External causes"
        ],
        "range": [
          "#d6604d",
          "#2166ac",
          "#b0b0b0",
          "#b0b0b0",
          "#b0b0b0",
          "#b0b0b0",
          "#b0b0b0"
        ]
      }
    },
    "opacity": {
      "condition": {
        "param": "cause_selection",
        "value": 1
      },
      "value": 0.15
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "params": [
        {
          "name": "cause_selection",
          "select": {
            "type": "point",
            "fields": [
              "Cause"
            ],
            "toggle": false
          },
          "bind": {
            "input": "select",
            "options": [
              null,
              "COVID-19",
              "Respiratory",
              "Cancer",
              "Circulatory",
              "Dementia",
              "Alzheimers",
              "External causes"
            ],
            "labels": [
              "All causes",
              "COVID-19",
              "Respiratory",
              "Cancer",
              "Circulatory",
              "Dementia",
              "Alzheimers",
              "External causes"
            ],
            "name": "Highlight a cause: "
          }
        }
      ]
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 50
      },
      "encoding": {
        "tooltip": [
          {
            "field": "Cause",
            "type": "nominal"
          },
          {
            "field": "Year",
            "type": "ordinal"
          },
          {
            "field": "Rate",
            "type": "quantitative",
            "format": ".1f",
            "title": "Deaths per 100,000"
          },
          {
            "field": "Deaths",
            "type": "quantitative",
            "title": "Number of deaths"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2024"
        },
        {
          "calculate": "datum.Cause == 'Cancer' ? datum.Rate + 3 : datum.Cause == 'Circulatory' ? datum.Rate - 3 : datum.Cause == 'Alzheimers' ? datum.Rate + 4 : datum.Cause == 'COVID-19' ? datum.Rate - 4 : datum.Cause == 'Dementia' ? datum.Rate + 2.5 : datum.Cause == 'External causes' ? datum.Rate - 2.5 : datum.Rate",
          "as": "LabelPosition"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "LabelPosition",
          "type": "quantitative"
        },
        "text": {
          "field": "Cause",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 12,
      "subtitleColor": "#555"
    },
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
