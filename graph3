{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/sarahmooney-oss/death_by_population_rates/refs/heads/main/deaths_population_rates.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum['Cause of Death'] == 'C00-C99 Malignant neoplasms' ? 'Cancer' : datum['Cause of Death'] == 'I00-I99 Diseases of the circulatory system' ? 'Circulatory' : datum['Cause of Death'] == 'J00-J99 Diseases of the respiratory system' ? 'Respiratory' : datum['Cause of Death'] == 'V00-Y98 External causes of injury and poisoning' ? 'External causes' : datum['Cause of Death'] == 'F01 and F03 Dementia (types of)' ? 'Dementia' : datum['Cause of Death'] == 'G30 Alzheimer disease' ? 'Alzheimers' : 'COVID-19'",
      "as": "Cause"
    },
    {
      "calculate": "datum['Area of Residence'] == 'Galway County Council' ? 'Galway County' : datum['Area of Residence'] == 'Cork County Council' ? 'Cork County' : replace(replace(replace(datum['Area of Residence'], ' City & County Council', ' City & Co.'), ' County Council', ''), ' City Council', ' City')",
      "as": "Area"
    }
  ],
  "vconcat": [
    {
      "width": 520,
      "height": {
        "step": 16
      },
      "title": {
        "text": "Mayo's COVID-19 death rate was three times Galway City's",
        "subtitle": [
          "Average yearly COVID-19 deaths per 100,000 by local authority, 2020–2024 (dashed line = Ireland).",
          "Click a council to see its trend below.",
          "Source: CSO VSA101 & Census 2022. Rates use 2022 population for every year; not age-adjusted."
        ]
      },
      "transform": [
        {
          "filter": "datum.Cause == 'COVID-19'"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Deaths",
              "as": "Deaths"
            },
            {
              "op": "sum",
              "field": "Population",
              "as": "Population"
            }
          ],
          "groupby": [
            "Area"
          ]
        },
        {
          "calculate": "datum.Deaths / datum.Population * 100000",
          "as": "Rate"
        },
        {
          "calculate": "indexof(['Dublin City', 'South Dublin', 'Fingal', 'Dún Laoghaire Rathdown'], datum.Area) >= 0 ? 'Dublin councils' : indexof(['Galway City', 'Galway County', 'Mayo', 'Roscommon', 'Clare'], datum.Area) >= 0 ? 'Galway & neighbours' : 'Other councils'",
          "as": "Region"
        }
      ],
      "layer": [
        {
          "params": [
            {
              "name": "council_selection",
              "select": {
                "type": "point",
                "fields": [
                  "Area"
                ],
                "toggle": false
              },
              "value": [
                {
                  "Area": "Mayo"
                }
              ]
            }
          ],
          "mark": "bar",
          "encoding": {
            "y": {
              "field": "Area",
              "type": "nominal",
              "title": null,
              "sort": {
                "op": "sum",
                "field": "Rate",
                "order": "descending"
              }
            },
            "x": {
              "field": "Rate",
              "type": "quantitative",
              "title": "COVID-19 deaths per 100,000 per year"
            },
            "color": {
              "field": "Region",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Dublin councils",
                  "Galway & neighbours",
                  "Other councils"
                ],
                "range": [
                  "#e6a100",
                  "#4d9221",
                  "#cfcfcf"
                ]
              },
              "legend": {
                "title": null,
                "orient": "bottom-right"
              }
            },
            "stroke": {
              "condition": {
                "param": "council_selection",
                "empty": false,
                "value": "black"
              },
              "value": null
            },
            "strokeWidth": {
              "value": 1.5
            },
            "tooltip": [
              {
                "field": "Area",
                "type": "nominal",
                "title": "Council"
              },
              {
                "field": "Rate",
                "type": "quantitative",
                "format": ".1f",
                "title": "Deaths per 100,000 per year"
              },
              {
                "field": "Deaths",
                "type": "quantitative",
                "title": "Deaths 2020–2024"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 3,
            "fontSize": 10
          },
          "encoding": {
            "y": {
              "field": "Area",
              "type": "nominal",
              "sort": {
                "op": "sum",
                "field": "Rate",
                "order": "descending"
              }
            },
            "x": {
              "field": "Rate",
              "type": "quantitative"
            },
            "text": {
              "field": "Rate",
              "type": "quantitative",
              "format": ".1f"
            }
          }
        },
        {
          "transform": [
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "Deaths",
                  "as": "Deaths"
                },
                {
                  "op": "sum",
                  "field": "Population",
                  "as": "Population"
                }
              ]
            },
            {
              "calculate": "datum.Deaths / datum.Population * 100000",
              "as": "Rate"
            }
          ],
          "mark": {
            "type": "rule",
            "strokeDash": [
              4,
              3
            ]
          },
          "encoding": {
            "x": {
              "field": "Rate",
              "type": "quantitative"
            }
          }
        }
      ]
    },
    {
      "width": 520,
      "height": 200,
      "title": {
        "text": "Selected council: COVID-19 vs respiratory deaths by year",
        "fontSize": 13
      },
      "transform": [
        {
          "filter": {
            "param": "council_selection"
          }
        },
        {
          "filter": "datum.Cause == 'COVID-19' || datum.Cause == 'Respiratory'"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Deaths",
              "as": "Deaths"
            },
            {
              "op": "sum",
              "field": "Population",
              "as": "Population"
            }
          ],
          "groupby": [
            "Year",
            "Cause",
            "Area"
          ]
        },
        {
          "calculate": "datum.Deaths / datum.Population * 100000",
          "as": "Rate"
        }
      ],
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Rate",
          "type": "quantitative",
          "title": "Deaths per 100,000"
        },
        "color": {
          "field": "Cause",
          "type": "nominal",
          "scale": {
            "domain": [
              "COVID-19",
              "Respiratory"
            ],
            "range": [
              "#d6604d",
              "#2166ac"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top-right"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "strokeWidth": 2.5
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 50
          },
          "encoding": {
            "tooltip": [
              {
                "field": "Area",
                "type": "nominal",
                "title": "Council"
              },
              {
                "field": "Cause",
                "type": "nominal"
              },
              {
                "field": "Year",
                "type": "ordinal"
              },
              {
                "field": "Rate",
                "type": "quantitative",
                "format": ".1f",
                "title": "Deaths per 100,000"
              },
              {
                "field": "Deaths",
                "type": "quantitative",
                "title": "Number of deaths"
              }
            ]
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "config": {
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 12,
      "subtitleColor": "#555"
    },
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}
