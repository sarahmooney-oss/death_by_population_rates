{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Death rates by cause compared with cancer rates, by council",
    "subtitle": [
      "Each point is one council: its cancer death rate (x) against another cause (y). Average yearly deaths per 100,000, 2020–2024.",
      "Cancer rates are highest where populations are older, so a tight pattern suggests age; a scattered one suggests something else. Each panel has its own y-axis.",
      "Source: CSO VSA101 & Census 2022. Rates use 2022 population for every year; not age-adjusted."
    ]
  },
  "data": {
    "url": "https://raw.githubusercontent.com/sarahmooney-oss/death_by_population_rates/refs/heads/main/deaths_population_rates.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "datum['Cause of Death'] == 'C00-C99 Malignant neoplasms' ? 'Cancer' : datum['Cause of Death'] == 'I00-I99 Diseases of the circulatory system' ? 'Circulatory' : datum['Cause of Death'] == 'J00-J99 Diseases of the respiratory system' ? 'Respiratory' : datum['Cause of Death'] == 'V00-Y98 External causes of injury and poisoning' ? 'External causes' : datum['Cause of Death'] == 'F01 and F03 Dementia (types of)' ? 'Dementia' : datum['Cause of Death'] == 'G30 Alzheimer disease' ? 'Alzheimers' : 'COVID-19'",
      "as": "Cause"
    },
    {
      "calculate": "datum['Area of Residence'] == 'Galway County Council' ? 'Galway County' : datum['Area of Residence'] == 'Cork County Council' ? 'Cork County' : replace(replace(replace(datum['Area of Residence'], ' City & County Council', ' City & Co.'), ' County Council', ''), ' City Council', ' City')",
      "as": "Area"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "Deaths",
          "as": "Deaths"
        },
        {
          "op": "sum",
          "field": "Population",
          "as": "Population"
        }
      ],
      "groupby": [
        "Area",
        "Cause"
      ]
    },
    {
      "calculate": "datum.Deaths / datum.Population * 100000",
      "as": "Rate"
    },
    {
      "calculate": "datum.Cause == 'Cancer' ? datum.Rate : null",
      "as": "CancerRateOnly"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "CancerRateOnly",
          "as": "CancerRate"
        }
      ],
      "groupby": [
        "Area"
      ]
    },
    {
      "filter": {
        "field": "Cause",
        "oneOf": [
          "Circulatory",
          "Respiratory",
          "Dementia",
          "External causes",
          "Alzheimers",
          "COVID-19"
        ]
      }
    },
    {
      "calculate": "datum.Cause == 'Circulatory' ? 'Circulatory (r = 0.91)' : datum.Cause == 'Respiratory' ? 'Respiratory (r = 0.84)' : datum.Cause == 'Dementia' ? 'Dementia (r = 0.64)' : datum.Cause == 'External causes' ? 'External causes (r = 0.61)' : datum.Cause == 'Alzheimers' ? 'Alzheimers (r = 0.56)' : 'COVID-19 (r = 0.19)'",
      "as": "Panel"
    },
    {
      "calculate": "indexof(['Dublin City', 'South Dublin', 'Fingal', 'Dún Laoghaire Rathdown'], datum.Area) >= 0 ? 'Dublin councils' : indexof(['Galway City', 'Galway County', 'Mayo', 'Roscommon', 'Clare'], datum.Area) >= 0 ? 'Galway & neighbours' : 'Other councils'",
      "as": "Region"
    }
  ],
  "facet": {
    "field": "Panel",
    "type": "nominal",
    "title": null,
    "sort": [
      "Circulatory (r = 0.91)",
      "Respiratory (r = 0.84)",
      "Dementia (r = 0.64)",
      "External causes (r = 0.61)",
      "Alzheimers (r = 0.56)",
      "COVID-19 (r = 0.19)"
    ],
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": "bold"
    }
  },
  "spec": {
    "width": 190,
    "height": 190,
    "mark": {
      "type": "circle",
      "size": 60,
      "opacity": 0.9,
      "stroke": "white",
      "strokeWidth": 0.5
    },
    "encoding": {
      "x": {
        "field": "CancerRate",
        "type": "quantitative",
        "title": "Cancer deaths per 100,000",
        "scale": {
          "zero": false
        }
      },
      "y": {
        "field": "Rate",
        "type": "quantitative",
        "title": "Deaths per 100,000",
        "scale": {
          "zero": false
        }
      },
      "color": {
        "field": "Region",
        "type": "nominal",
        "scale": {
          "domain": [
            "Dublin councils",
            "Galway & neighbours",
            "Other councils"
          ],
          "range": [
            "#e6a100",
            "#4d9221",
            "#cfcfcf"
          ]
        },
        "legend": {
          "title": null,
          "orient": "top"
        }
      },
      "tooltip": [
        {
          "field": "Area",
          "type": "nominal",
          "title": "Council"
        },
        {
          "field": "CancerRate",
          "type": "quantitative",
          "format": ".1f",
          "title": "Cancer per 100,000"
        },
        {
          "field": "Cause",
          "type": "nominal"
        },
        {
          "field": "Rate",
          "type": "quantitative",
          "format": ".1f",
          "title": "Rate per 100,000"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "title": {
      "anchor": "start",
      "fontSize": 16,
      "subtitleFontSize": 12,
      "subtitleColor": "#555"
    },
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  },
  "columns": 3
}
